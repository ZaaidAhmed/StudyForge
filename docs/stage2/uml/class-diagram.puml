@startuml StudyForgeStage2Implemented
title StudyForge Stage 2 — Implemented class view
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "Presentation" {
  class CourseController
  class MaterialController
  class AskController
  class LearningController
  class FlashcardController
  class QuizController
  class ProgressController
  class StudyPlanController
  class RecommendationController
  class HistoryController
  class AgentController
  class AiStatusController
  class CoursePilotCommand
  class CliRunner
}

package "Application boundary" {
  class StudyAgentFacade {
    +askQuestion(...)
    +summarizeDocument(...)
    +extractConcepts(...)
    +generateFlashcards(...)
    +generateQuiz(...)
    +submitQuiz(...)
    +agentAssist(...)
  }
}

package "Course and learning services" {
  class CourseService
  class CourseMaterialService
  class CourseSearchService
  class GroundedQuestionService
  class SummarizationService
  class ConceptExtractionService
  class FlashcardGenerationService
  class FlashcardReviewService
  class QuizGenerationService
  class QuizAttemptService
  class WrongAnswerExplanationService
  class ProgressService
  class StudyPlanService
  interface StudyPlanningStrategy
  class BalancedStudyStrategy
  class WeakTopicFocusedStrategy
  class ExamCramStrategy
  class RecommendationService
  class LearningHistoryService
}

package "Bounded agent" {
  class AgentCoordinator
  class IntentAnalyzer
  class TaskPlanner
  class AgentPlanValidator
  class AgentToolManager
  class MemoryManager
  class ResponseSynthesizer
}

package "Provider boundary" {
  interface LlmClient
  class RoutingLlmClient
  class OllamaLlmAdapter
  class GeminiLlmAdapter
  class PromptBuilder
  class GroundingContextBuilder
  class StructuredResponseParser
  class AiProperties
}

package "Domain and persistence" {
  class Course
  class CourseDocument
  class DocumentChunk
  class Flashcard
  class FlashcardSource
  class FlashcardReview
  class Quiz
  class QuizQuestion
  class QuizSource
  class QuizAttempt
  class QuizResponse
  class StudyPlan
  class StudyPlanItem
  interface CourseRepository
  interface CourseDocumentRepository
  interface DocumentChunkRepository
  interface FlashcardRepository
  interface FlashcardReviewRepository
  interface QuizRepository
  interface QuizAttemptRepository
  interface StudyPlanRepository
}

CourseController --> StudyAgentFacade
MaterialController --> StudyAgentFacade
AskController --> StudyAgentFacade
LearningController --> StudyAgentFacade
FlashcardController --> StudyAgentFacade
