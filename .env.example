# StudyForge local configuration example. Do not place real credentials here.
# Local Ollama example:
COURSEPILOT_AI_ENABLED=true
COURSEPILOT_AI_PROVIDER=ollama
COURSEPILOT_AI_MODEL=qwen3:4b
COURSEPILOT_AI_BASE_URL=http://localhost:11434
COURSEPILOT_AI_OLLAMA_BASE_URL=http://localhost:11434
COURSEPILOT_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Hosted Gemini example. Never commit a real key.
# COURSEPILOT_AI_PROVIDER=gemini
# COURSEPILOT_AI_MODEL=gemini-3.5-flash-lite
# COURSEPILOT_AI_BASE_URL=https://generativelanguage.googleapis.com
# COURSEPILOT_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_API_KEY=replace_with_your_key
